                    "contentType": "Text",
                    "content": "Hooks for before and after paste actions:"
                }
            ]
        },
        {
            "blockType": "Code",
            "content": [
                {
                    "contentType": "Text",
                    "content": "afterPasteCleanup: (args: AfterPasteCleanupEventArgs) => { \n // Process pasted content or update UI \n } \n beforePasteCleanup: (args: BeforePasteCleanupEventArgs) => { \n // Modify content before cleanup if needed \n }"
                }
            ]
        },
