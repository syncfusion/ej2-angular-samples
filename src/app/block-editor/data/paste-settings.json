        },
        {
            "blockType": "Paragraph",
            "content": [
                {
                    "contentType": "Text",
                    "content": "You can configure paste cleanup behavior using the following settings:"
                }
            ]
        },
        {
            "blockType": "Code",
            "content": [
                {
                    "contentType": "Text",
                    "content": "pasteCleanupSettings: {\n deniedTags: ['script', 'iframe'], // Tags to remove\n keepFormat: true, // Keep original formatting\n plainPaste: false // Force plain text paste\n};"
                }
            ]
        },
        {
            "blockType": "Heading",
            "properties": {
                "level": 3
            },
            "content": [
